              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"facility_name\": \"FA0148210 - GOLDEN DRAGON\",\n  \"description\": \"Walk-in cooler at 47F.\",\n  \"status\": \"closed\",\n  \"program_element\": \"BAKERY\",\n  \"inspection_date\": \"2026-10-16T10:30:00-07:00\"\n}"
            }
          }
        },
        {
