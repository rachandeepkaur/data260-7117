              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"facility_name\": 12345,\n  \"description\": \"Walk-in cooler at 47F.\",\n  \"status\": \"failed\",\n  \"program_element\": \"ROUTINE HEALTH INSPECTION\",\n  \"inspection_date\": true\n}"
            }
          }
        },
        {
          "name": "Bad date format (422)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base}}/api/doc/inspections",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "doc",
                "inspections"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"facility_name\": \"FA0148210 - GOLDEN DRAGON\",\n  \"description\": \"Walk-in cooler at 47F.\",\n  \"status\": \"failed\",\n  \"program_element\": \"ROUTINE HEALTH INSPECTION\",\n  \"inspection_date\": \"16/10/2026\"\n}"
            }
          }
        },
        {
          "name": "Malformed ObjectId (400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base}}/api/doc/inspections/not-an-id",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "doc",
                "inspections",
                "not-an-id"
              ]
            },
            "header": []
          }
        },
        {
          "name": "Not found (404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base}}/api/doc/inspections/0123456789abcdef01234567",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "doc",
                "inspections",
                "0123456789abcdef01234567"
              ]
            },
            "header": []
          }
        }
      ]
    },
    {
      "name": "Part 2 - Chat memory",
      "item": [
        {
          "name": "Chat",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base}}/api/chat",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "chat"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"s7117-rachandeep\",\n  \"session_id\": \"s7117-rachandeep-postman\",\n  \"message\": \"Hi, I'm Rachandeep Kaur. I cover Willow Glen.\"\n}"
            }
          }
        },
        {
          "name": "Memory",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base}}/api/memory/s7117-rachandeep",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "memory",
                "s7117-rachandeep"
              ]
            },
            "header": []
          }
        },
        {
          "name": "Aggregate",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base}}/api/aggregate/s7117-rachandeep",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "aggregate",
                "s7117-rachandeep"
              ]
            },
            "header": []
          }
        }
      ]
    }
  ]
}