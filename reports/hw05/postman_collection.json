        ],
        "url": {
          "raw": "http://127.0.0.1:8817/api/inspectors/{{inspector_id}}",
          "protocol": "http",
          "host": [
            "127.0.0.1"
          ],
          "port": "8817",
          "path": [
            "api",
            "inspectors",
            "{{inspector_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"district\": \"Willow Glen\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 Create inspection (linked to new inspector)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8817/api/records",
          "protocol": "http",
          "host": [
            "127.0.0.1"
          ],
          "port": "8817",
          "path": [
            "api",
            "records"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"inspection_code\": \"INS-005001\",\n  \"facility_name\": \"FA0206933 - YUMMY KITCHEN\",\n  \"site_address\": \"1711 BRANHAM LN A9, SAN JOSE, CA 95118\",\n  \"score\": 94,\n  \"inspector_id\": {{inspector_id}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"record_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
