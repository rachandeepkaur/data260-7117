{
  "info": {
    "name": "HW5 s7117 Inspections + Inspectors",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the requests in numbered order (or use Run collection). 01 Login stores the HttpOnly session cookie; 02/06 save the new ids in {{inspector_id}} / {{record_id}} for the later requests."
  },
  "item": [
    {
      "name": "01 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8817/api/auth/login",
          "protocol": "http",
          "host": [
            "127.0.0.1"
          ],
          "port": "8817",
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@s7117.dev\",\n  \"password\": \"Inspect!7117\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 Create inspector",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8817/api/inspectors",
          "protocol": "http",
          "host": [
            "127.0.0.1"
          ],
          "port": "8817",
          "path": [
            "api",
            "inspectors"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Rachandeep Kaur\",\n  \"district\": \"Downtown San Jose\",\n  \"email\": \"rachandeep.kaur@sccgov-eh.org\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"inspector_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 List inspectors (paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8817/api/inspectors?page=1&page_size=5",
          "protocol": "http",
          "host": [
            "127.0.0.1"
          ],
          "port": "8817",
          "path": [
            "api",
            "inspectors"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "page_size",
              "value": "5"
            }
          ]
        }
      }
    },
    {
      "name": "04 Get inspector",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8817/api/inspectors/{{inspector_id}}",
          "protocol": "http",
          "host": [
            "127.0.0.1"
          ],
          "port": "8817",
          "path": [
            "api",
            "inspectors",
            "{{inspector_id}}"
          ]
        }
      }
    },
    {
      "name": "05 Update inspector",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
